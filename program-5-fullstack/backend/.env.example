PORT=5000
NODE_ENV=development

# Database Dialect: 'postgres' or 'sqlite'
# For local Windows zero-friction run, defaults to sqlite.
# For production Render/Supabase/Postgres, set DB_DIALECT=postgres and DATABASE_URL
DB_DIALECT=sqlite
DB_STORAGE=./parkify.sqlite

# PostgreSQL Configuration (Active when DB_DIALECT=postgres or DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parkify_db
DB_USER=postgres
DB_PASSWORD=postgres
# DATABASE_URL=postgres://postgres:password@localhost:5432/parkify_db

# JWT Secret
JWT_SECRET=parkify_enterprise_jwt_secret_key_2026_super_secure
JWT_EXPIRES_IN=7d
